---
// Bewerbung im Design der Website. Texte unverändert (die Textübergabe vom
// 09.11.2026 nimmt /bewerbung ausdrücklich aus, folgt später).
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import EosMark from '../components/EosMark.astro';
import image from '../assets/images/bewerbung.jpg';

const jobs = [
  {
    label: 'Team Offenbach',
    href: 'https://join.com/companies/eos-hilfen/16273540-sozialpaedagogische-fachkraft-w-m-d-fuer-ambulante-hilfen-in-offenbach',
  },
  {
    label: 'Team Frankfurt',
    href: 'https://join.com/companies/eos-hilfen/16330753-sozialpaedagogische-fachkraft-w-m-d-in-frankfurt-am-main',
  },
];
---

<SiteLayout
  title="Bewerbung"
  description="Verstärke unser Team: sozialpädagogische Fachkräfte (w/m/d) für ambulante Hilfen in Offenbach und Frankfurt am Main."
>
  <section class="hero hero--page">
    <div class="hero__content">
      <p class="chip hero-in" style="--d:0"><span class="dawn-dot" aria-hidden="true"></span>Bewerbung</p>
      <h1 class="hero__title hero__title--page">
        <span class="hero-line"><span class="hero-in" style="--d:1">Verstärke unser Team</span></span>{' '}
        <span class="hero-line"><span class="hero-in" style="--d:2">und gestalte <mark>Zukunft!</mark></span></span>
      </h1>
      <p class="lead hero-in" style="--d:3">
        Du möchtest eine sinnstiftende Aufgabe in der ambulanten Kinder- und Jugendhilfe übernehmen? Bei uns erwartet
        dich ein engagiertes, diverses Team und die Möglichkeit, aktiv an der Entwicklung junger Menschen mitzuwirken.
      </p>
      <dl class="facts hero-in" style="--d:4">
        <div>
          <dt>Unsere Standorte:</dt>
          <dd>Offenbach (Main) &amp; Frankfurt (Main)</dd>
        </div>
        <div>
          <dt>Unsere Einsatzgebiete:</dt>
          <dd>Frankfurt, Main-Taunus-Kreis, Offenbach, Kreis Offenbach &amp; Main-Kinzig-Kreis</dd>
        </div>
        <div>
          <dt>Unsere Leistungen:</dt>
          <dd>siehe kap. <a class="link-arrow" href="/#leistungen">Leistungen</a></dd>
        </div>
      </dl>
      <p class="facts__apply hero-in" style="--d:5"><strong>Jetzt bewerben</strong></p>
      <p class="hero__actions hero-in" style="--d:5">
        {
          jobs.map((job, i) => (
            <a class:list={['btn', i === 0 ? 'btn--primary' : 'btn--ghost']} href={job.href} target="_blank" rel="noopener" data-magnet>
              {job.label}
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          ))
        }
      </p>
    </div>

    <figure class="hero__media">
      <div class="arch arch--hero">
        <Image
          src={image}
          alt="Junge Erwachsene sitzen lachend zusammen in einem hellen Raum"
          widths={[640, 960, 1400]}
          sizes="(min-width: 992px) 46vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hero__dawn">
        <EosMark variant="icon" class="mark-dawn" />
      </div>
    </figure>
  </section>
</SiteLayout>
