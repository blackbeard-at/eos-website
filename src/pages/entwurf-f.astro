      transition-delay: var(--rd, 0ms);
    }

    .js .f [data-reveal-group] > :nth-child(2) {
      transition-delay: 60ms;
    }
    .js .f [data-reveal-group] > :nth-child(3) {
      transition-delay: 120ms;
    }
    .js .f [data-reveal-group] > :nth-child(4) {
      transition-delay: 180ms;
    }

    .js .f [data-reveal].is-visible,
    .js .f [data-reveal-group].is-visible > * {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Statement auf Logo-Rot ---------- */
  .f .statement {
    padding: 0 var(--pad-x);
  }

  .f .statement__panel {
    position: relative;
    max-width: var(--container);
    margin-inline: auto;
    padding: clamp(3.5rem, 8vw, 7rem) clamp(1.5rem, 7vw, 7rem);
    overflow: hidden;
    border-radius: 40px;
    background: var(--red);
    color: var(--on-red);
    isolation: isolate;
  }

  /* Riesiges „o“ im Hintergrund, ganz zurückgenommen */
  .f .statement__o {
    position: absolute;
    z-index: -1;
    right: -8%;
    bottom: -30%;
    width: min(48vw, 600px);
    height: auto;
    opacity: 0.16;
  }

  .f .statement__o .o-ring {
    fill: var(--paper);
  }

  .f .statement__o .o-light {
    fill: #ffd9b5;
  }

  @media (prefers-reduced-motion: no-preference) {
    .js .f .statement__o .o-spin {
      animation: f-sun-orbit 60s linear infinite;
    }
  }

  .f .statement__title {
    max-width: 22em;
    color: var(--on-red);
    font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3.6rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.035em;
    hyphens: auto;
  }

  .f .scrub:has(.dawn-o) {
    white-space: nowrap;
  }

  @media (max-width: 520px) {
    .f .statement__title {
      font-size: 1.7rem;
    }
  }

  .f .statement__title.is-scrubbing .scrub {
    color: color-mix(in srgb, var(--on-red) calc(var(--lit, 0) * 100%), rgba(255, 255, 255, 0.36));
  }

  .f .statement__text {
    max-width: 40rem;
    margin-top: 1.75rem;
    font-size: var(--text-large);
    font-weight: 500;
  }

  /* Das „o“ in „positiv“ ist das Logo-o: Ring in Weiß, Lichtbogen in Pfirsich */
  .f .dawn-o {
    position: relative;
    display: inline-block;
  }

  .f .dawn-o > span {
    visibility: hidden;
  }

  .f .dawn-o .eos-mark {
    position: absolute;
    left: 50%;
    top: 58%;
    width: 0.62em;
    height: 0.62em;
    transform: translate(-50%, -50%);
  }

  .f .dawn-o .o-ring {
    fill: currentColor;
  }

  .f .dawn-o .o-light {
    fill: #ffd9b5;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .f .statement__title.is-done .dawn-o .o-light {
    opacity: 1;
  }

  /* Auf Rot geht das Licht von Weiß nach Pfirsich auf */
  .f .dawn-o {
    --dawn-from: #ffffff;
    --dawn-mid: #fff0e2;
    --dawn-to: #ffd9b5;
  }

  @media (prefers-reduced-motion: no-preference) {
    .js .f .statement__title.is-done .dawn-o .o-spin {
      animation:
        f-sun-turn-soft 1400ms var(--ease-out) both,
        f-sun-orbit 24s linear 1400ms infinite;
    }

    .js .f .statement__title.is-done .dawn-o .o-light {
      animation: f-dawn-warm 1400ms ease-out both;
    }
  }

  /* ---------- Leitbild: zwei Bild-Text-Paare ---------- */
  .f .leitbild {
    max-width: calc(var(--container) + 2 * var(--pad-x));
    margin-inline: auto;
    padding: var(--pad-y) var(--pad-x);
  }

  .f .split {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .f .split + .split {
    margin-top: var(--pad-y);
  }

  .f .split--reverse .split__media {
    order: 2;
  }

  .f .arch--split {
    aspect-ratio: 4 / 4.4;
  }

  .f .split__text .h2 {
    margin-bottom: 1.25rem;
  }

  @media (max-width: 900px) {
    .f .split {
      grid-template-columns: minmax(0, 1fr);
    }

    .f .split--reverse .split__media {
      order: 0;
    }

    .f .split__media {
      max-width: 520px;
    }
  }

  /* „Mehr erfahren“: Pille mit rundem Plus */
  .f .more {
    margin-top: 1.5rem;
  }

  .f .more summary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  .f .more summary::-webkit-details-marker {
    display: none;
  }

  .f .more summary::after {
    content: '+';
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--red);
    color: var(--on-red);
    font-size: 1.1rem;
    line-height: 1;
    transition:
      transform 250ms var(--ease-out),
      background-color 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .f .more summary:hover::after {
      transform: rotate(90deg);
    }
  }

  .f .more[open] summary::after {
    transform: rotate(45deg);
  }

  .f .more__detail {
    margin-top: 0.75rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .f .more__detail > * + * {
    margin-top: 0.6rem;
  }

  /* ---------- Für wen wir da sind ---------- */
  .f .zielgruppen {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: calc(var(--container) + 2 * var(--pad-x));
    margin-inline: auto;
    padding: 0 var(--pad-x) var(--pad-y);
  }

  .f .zg {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(2rem, 4vw, 3.25rem);
    border-radius: 40px;
    background: var(--cream);
  }

  .f .zg .chip {
    background: var(--paper);
  }

  .f .zg__text {
    font-size: var(--h3);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .f .zg .more {
    margin-top: auto;
    padding-top: 2rem;
  }

  /* Zweite Karte in Anthrazit – wie die Flächen bei IEV */
  .f .zg--ink {
    background: var(--ink);
    color: var(--paper);
  }

  .f .zg--ink .zg__text {
    color: var(--paper);
  }

  .f .zg--ink .chip {
    background: rgba(255, 255, 255, 0.1);
    color: var(--paper);
  }

  @media (max-width: 900px) {
    .f .zielgruppen {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- Abschnittskopf (wie IEV) ---------- */
  .f .section-head {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: end;
    gap: 1.5rem 4rem;
    margin-bottom: 3rem;
  }

  @media (max-width: 991px) {
    .f .section-head {
      grid-template-columns: minmax(0, 1fr);
      margin-bottom: 2rem;
    }
  }

  /* ---------- Leistungen: Karten auf Creme ---------- */
  .f .leistungen {
    max-width: calc(var(--container) + 2 * var(--pad-x));
    margin-inline: auto;
    padding: var(--pad-y) var(--pad-x);
    border-radius: 48px;
    background: var(--cream);
  }

  .f .leistungen .chip {
    background: var(--paper);
  }

  .f .cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 1fr; /* alle Karten gleich hoch */
    gap: 1rem;
  }

  .f .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.75rem 1.5rem 1.25rem;
    border-radius: 28px;
    background: var(--paper);
    transition: transform 300ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .f .card:hover {
      transform: translateY(-4px);
    }
  }

  .f .card__label {
    color: var(--red-text);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .f .card__title {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    hyphens: auto;
  }

  .f .card__teaser {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .f .card__more {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  @media (max-width: 1200px) {
    .f .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .f .leistungen {
      border-radius: 0;
    }

    .f .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .f .cards {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: auto;
    }
  }

  /* ---------- Methoden: senkrechte Tabs ---------- */
  .f .methoden {
    max-width: calc(var(--container) + 2 * var(--pad-x));
    margin-inline: auto;
    padding: var(--pad-y) var(--pad-x);
  }

  .f .tabs {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 2.5rem 4rem;
    align-items: start;
  }

  .f .tabs__side {
    position: sticky;
    top: 110px;
  }

  .f .tabs__list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem;
    border-radius: 28px;
    background: var(--cream);
  }

  .f .tabs__pill {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 20px;
    background: var(--paper);
    box-shadow: 0 1px 3px rgba(50, 51, 53, 0.1);
    transition:
      transform 350ms var(--ease-out),
      height 350ms var(--ease-out);
  }

  .f .tabs__list:not(.has-pill) .tabs__pill {
    display: none;
  }

  .f .tabs__tab {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    width: 100%;
    padding: 1rem 1.15rem;
    border: 0;
    border-radius: 20px;
    background: none;
    color: var(--ink-soft);
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    text-align: left;
    cursor: pointer;
    transition: color 200ms ease;
  }

  .f .tabs__list:not(.has-pill) .tabs__tab[aria-selected='true'] {
    background: var(--paper);
  }

  .f .tabs__tab[aria-selected='true'] {
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .f .tabs__tab:hover {
      color: var(--ink);
    }
  }

  .f .tabs__tab:active {
    scale: 0.98;
  }

  /* Kleiner Punkt vor jedem Tab: beim aktiven geht das Morgenrot auf */
  .f .tabs__ray {
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    margin-top: 0.35rem;
    border-radius: 50%;
    border: 2px solid rgba(50, 51, 53, 0.25);
    transition:
      border-color 250ms ease,
      background-color 250ms ease,
      box-shadow 500ms var(--ease-out);
  }

  .f .tabs__tab[aria-selected='true'] .tabs__ray {
    border-color: var(--red);
    background: var(--red);
    box-shadow:
      0 0 0 4px rgba(231, 146, 69, 0.35),
      0 0 0 8px rgba(231, 146, 69, 0.18);
  }

  .f .arch--tabs {
    aspect-ratio: 3 / 2;
    margin-top: 1rem;
    border-radius: 28px;
  }

  .f .panel {
    outline-offset: 6px;
  }

  .f .panel[hidden] {
    display: none;
  }

  .f .panel__num {
    color: var(--red-text);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .f .panel .h3 {
    margin-top: 0.35rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .f .panel.is-in > * {
      animation: f-panel-text 450ms var(--ease-out) both;
    }

    .f .panel.is-in > :nth-child(2) {
      animation-delay: 40ms;
    }
    .f .panel.is-in > :nth-child(3) {
      animation-delay: 80ms;
    }
    .f .panel.is-in > :nth-child(n + 4) {
      animation-delay: 120ms;
    }
  }

  @keyframes f-panel-text {
    from {
      opacity: 0;
      transform: translateY(10px);
      filter: blur(3px);
    }
  }

  .f .panel__intro {
    margin-top: 0.75rem;
    color: var(--ink);
    font-size: var(--text-large);
    font-weight: 500;
  }

  .f .panel__list {
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .f .panel__list li {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 0.25rem 1.5rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .f .panel__list strong {
    color: var(--ink);
    font-weight: 700;
  }

  .f .panel__more {
    margin-top: 1rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  @media (max-width: 900px) {
    .f .tabs {
      grid-template-columns: minmax(0, 1fr);
    }

    .f .tabs__side {
      position: relative;
      top: auto;
    }

    .f .arch--tabs {
      display: none;
    }

    .f .panel__list li {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- Team ---------- */
  .f .team {
    max-width: calc(var(--container) + 2 * var(--pad-x));
    margin-inline: auto;
    padding: var(--pad-y) var(--pad-x);
  }

  .f .team > .h2 {
    margin-bottom: 2.5rem;
  }

  .f .team__group + .team__group {
    margin-top: 2.5rem;
  }

  .f .people {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .f .person {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding: 1.75rem;
    border-radius: 28px;
    background: var(--cream);
    transition:
      transform 300ms var(--ease-out),
      background-color 300ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .f .person:hover {
      background: var(--cream-dark);
      transform: translateY(-4px);
    }

    .f .person:hover .person__initials {
      background: var(--red);
      color: var(--on-red);
      box-shadow:
        0 0 0 5px rgba(231, 146, 69, 0.3),
        0 0 0 10px rgba(231, 146, 69, 0.15);
    }
  }

  .f .person__initials {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 1rem;
    border-radius: 50%;
    background: var(--peach);
    font-weight: 800;
    transition:
      background-color 300ms ease,
      color 300ms ease,
      box-shadow 500ms var(--ease-out);
  }

  .f .person h4 {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .f .person__role {
    display: flex;
    flex-direction: column;
    margin-bottom: 1rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .f .person__role strong {
    margin-bottom: 0.2rem;
    color: var(--ink);
    font-weight: 600;
  }

  .f .person__contact {
    display: flex;
    gap: 0.5rem;
    margin-top: auto;
  }

  .f .person__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }

  .f .person__btn svg {
    width: 22px;
    height: 22px;
  }

  .f .person__btn:hover {
    background: var(--red);
    color: var(--on-red);
  }

  .f .person__btn:active {
    scale: 0.95;
  }

  @media (max-width: 991px) {
    .f .people {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .f .people {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- Standorte ---------- */
  .f .standorte {
    max-width: calc(var(--container) + 2 * var(--pad-x));
    margin-inline: auto;
    padding: 0 var(--pad-x) var(--pad-y);
  }

  .f .standorte > .h2 {
    margin-bottom: 2.5rem;
  }

  .f .places {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .f .place {
    overflow: hidden;
    border-radius: 28px;
    background: var(--cream);
  }

  .f .place__text {
    padding: 1.5rem 1.75rem 1.75rem;
    color: var(--ink-soft);
  }

  .f .place__text p {
    margin-top: 0.5rem;
  }

  .f .map {
    position: relative;
    height: 300px;
    overflow: hidden;
    background: var(--cream-dark);
  }

  .f .map iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .f .map__consent {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    height: 100%;
    padding: 1.5rem;
    font-size: 0.875rem;
    text-align: center;
  }

  .f .map__o {
    width: 44px;
    height: auto;
  }

  .f .map__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.25rem;
  }

  @media (max-width: 900px) {
    .f .places {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- Footer: Creme wie bei IEV, Inhalte wie live ---------- */
  .f .foot {
    padding: clamp(3rem, 6vw, 4.5rem) var(--pad-x) 2rem;
    background: var(--cream);
    font-size: 0.9375rem;
  }

  .f .foot__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1.1fr;
    gap: 2.5rem;
    max-width: var(--container);
    margin-inline: auto;
  }

  .f .foot__brand .eos-mark {
    width: min(100%, 280px);
    height: auto;
  }

  .f .foot__address p + p {
    margin-top: 1rem;
  }

  .f .foot__address strong {
    color: var(--red-text);
    font-weight: 700;
  }

  .f .foot a:not(.btn) {
    color: var(--ink);
    transition: color 200ms ease;
  }

  .f .foot a:not(.btn):hover {
    color: var(--red-text);
  }

  .f .foot__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    max-width: var(--container);
    margin: 3rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.875rem;
  }

  @media (max-width: 900px) {
    .f .foot__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- Seitenpanel für „Mehr erfahren“ ---------- */
  .f .drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(580px, 100vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 32px 0 0 32px;
    background: var(--paper);
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.6;
    transition: transform 400ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .f .drawer[open] {
    display: flex;
    flex-direction: column;
  }

  .f .drawer::backdrop {
    background: rgba(50, 51, 53, 0.35);
    transition: opacity 300ms ease;
  }

  @starting-style {
    .f .drawer[open] {
      transform: translateX(100%);
    }
    .f .drawer[open]::backdrop {
      opacity: 0;
    }
  }

  .f .drawer.is-closing {
    transform: translateX(100%);
    transition-duration: 200ms;
  }

  .f .drawer.is-closing::backdrop {
    opacity: 0;
  }

  .f .drawer__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem 2rem 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .f .drawer__close {
    flex: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--cream);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      transform 160ms ease-out;
  }

  .f .drawer__close:hover {
    background: var(--cream-dark);
