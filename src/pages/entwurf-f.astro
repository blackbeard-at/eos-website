---
// Entwurf F – „Familienähnlichkeit“ (Stand 26.10.2026), nach dem Vorbild von
// helios-hilfen Entwurf F: Stimmung der IEV-Website (Muttergesellschaft), aber
// eigenständig und jünger. Texte und Navigation 1:1 von eos-hilfen.net.
// Die Bewegung folgt dem Logo: Eos ist die Morgenröte – im „o“ geht hinter
// dem roten Ring ein oranger Lichtbogen auf.
import { Image } from 'astro:assets';
import DraftLayout from '../layouts/DraftLayout.astro';
import EosMark from '../components/EosMark.astro';
import { site, navigation, applyLink, locations, panels, team } from '../data/site';
import hero from '../assets/images/hero-kinder.jpg';
import vision from '../assets/images/vision.jpg';
import leitbild from '../assets/images/leitbild.jpg';
import methodenImg from '../assets/images/methoden.jpg';

// Statement: Satz aus „Unsere Vision“, das „o“ in „positiv“ wird zum Logo-o
const statement =
  'Jeder junge Mensch verdient die Chance, das Leben selbstbestimmt, eigenständig und positiv zu gestalten.'.split(' ');

// Erster Absatz eines Akkordeon-Texts als Anriss, der Rest für das Seitenpanel
const firstP = (html: string) => (html.match(/<p>([\s\S]*?)<\/p>/)?.[1] ?? '').replace(/<[^>]+>/g, '');
const restHtml = (html: string) => html.replace(/<p>[\s\S]*?<\/p>\s*/, '');

// „§30 SGB VIII – Erziehungsbeistandschaft“ → Paragraf als Label, Rest als Titel
const splitTitle = (title: string) => {
  if (title.includes(' – ')) {
    const [label, ...rest] = title.split(' – ');
    return { label, name: rest.join(' – ') };
  }
  const m = title.match(/^(.*) nach (§.*)$/);
  return m ? { label: m[2], name: m[1] } : { label: '', name: title };
};

const leistungen = panels.leistungen.map((p) => ({
  ...splitTitle(p.title),
  title: p.title,
  teaser: firstP(p.html),
  body: restHtml(p.html),
  link: p.link,
}));

// Methoden: „Begriff –“ fett, danach die Erklärung; „uvm.“ als Schlusszeile
const methoden = panels.methoden.map((p, i) => {
  const rest = restHtml(p.html).replace(/^<p>|<\/p>$/g, '');
  const items = rest
    .split(/<br>\s*/)
    .map((s) => s.trim())
    .filter(Boolean)
    .map((s) => {
      const m = s.match(/<strong>([\s\S]*?)<\/strong>\s*([\s\S]*)/);
      return m ? { term: m[1].replace(/\s*–\s*$/, ''), desc: m[2].trim() } : { term: '', desc: s };
    });
  return {
    id: `methode-${i + 1}`,
    num: String(i + 1).padStart(2, '0'),
    name: p.title.replace(/^\d+\.\s*/, ''),
    lead: firstP(p.html),
    items: items.filter((it) => it.term !== 'uvm.'),
    more: items.some((it) => it.term === 'uvm.'),
  };
});

const zielgruppen = [
  {
    chip: 'Für junge Menschen & Familien',
    text: 'Wir sind da, um zu stärken – wertschätzend, ohne Druck, auf Augenhöhe.',
    panel: panels.zielgruppen[0],
  },
  {
    chip: 'Für Jugendämter',
    text: 'Verlässliche Zusammenarbeit, transparente Prozesse und fachlich fundierte Steuerung von Hilfen.',
    panel: panels.zielgruppen[1],
  },
];

// Team: Abschlüsse, Telefon und E-Mail aus den Zeilen der Live-Seite trennen
const groups = team.map((g) => ({
  label: g.label,
  members: g.members.map((m) => {
    const email = m.lines.find((l) => l.includes('[at]'));
    const phone = m.lines.find((l) => l.startsWith('+49'));
    return {
      ...m,
      email: email?.replace('[at]', '@'),
      phone,
      quals: m.lines.filter((l) => l !== email && l !== phone),
    };
  }),
}));

const initials = (name: string) => {
  const parts = name.split(' ').filter((w) => !w.endsWith('.'));
  return (parts[0][0] + parts.at(-1)![0]).toUpperCase();
};

// Kurzer Einführungstext (erster Absatz aus „mehr erfahren“ der Live-Seite)
const introText = (panels.intro[0].html.match(/<p>([\s\S]*?)<br>/)?.[1] ?? '').trim();

const year = new Date().getFullYear();
---

<DraftLayout title="Entwurf F · Familienähnlichkeit">
  <div class="f">
    <header class="nav">
      <a class="nav__logo" href="#willkommen" aria-label="EOS – Kinder- und Jugendhilfe, zum Anfang">
        <EosMark class="mark-intro" />
      </a>
      <nav class="nav__links" id="nav-f" aria-label="Hauptmenü">
        {navigation.map((s) => <a href={`#${s.href.split('#')[1]}`} data-spy>{s.label}</a>)}
        <a class="btn btn--primary btn--sm nav__cta" href={applyLink.href} data-magnet>{applyLink.label}</a>
      </nav>
      <button class="nav__menu" type="button" aria-expanded="false" aria-controls="nav-f" data-menu>
        <span class="sr-only">Menü</span><i></i><i></i>
      </button>
    </header>

    <main>
      <!-- Willkommen -->
      <section class="hero" id="willkommen">
        <div class="hero__content">
          <p class="chip hero-in" style="--d:0"><span class="dawn-dot" aria-hidden="true"></span>Freier Träger der ambulanten Kinder- und Jugendhilfe</p>
          <h1 class="hero__title">
            <span class="hero-line"><span class="hero-in" style="--d:1">Begleitung, die stärkt.</span></span>
            <span class="hero-line"><span class="hero-in" style="--d:2">Unterstützung, die <mark>wirkt.</mark></span></span>
          </h1>
          <p class="lead hero-in" style="--d:3">
            Seit 2012 unterstützen wir Kinder, Jugendliche, junge Erwachsene und Familien im Rhein-Main-Gebiet – ambulant,
            systemisch und mit echter menschlicher Nähe.
          </p>
          <p class="hero__more hero-in" style="--d:4">
            Unser Ziel: junge Menschen stärken, Familien stabilisieren und Hilfen wirksam gestalten – verlässlich,
            respektvoll und fachlich fundiert.
          </p>
          <p class="hero__actions hero-in" style="--d:5">
            <a class="btn btn--primary" href="#leistungen" data-magnet>
              Leistungen
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </a>
            <a class="btn btn--ghost" href="#unser-team" data-magnet>Unser Team</a>
          </p>
        </div>

        <figure class="hero__media">
          <div class="arch arch--hero">
            <Image src={hero} alt="Gruppe von Kindern und Jugendlichen steht lächelnd vor einem Wohnhaus" widths={[640, 960, 1400]} sizes="(min-width: 992px) 46vw, 100vw" loading="eager" fetchpriority="high" />
          </div>
          <!-- Großes „o“: Ring erscheint, dahinter geht der Lichtbogen auf -->
          <div class="hero__dawn">
            <EosMark variant="icon" class="mark-dawn" />
          </div>
        </figure>
      </section>

      <!-- Statement aus „Unsere Vision“, auf einer Fläche in Logo-Rot -->
      <section class="statement" aria-label="Unser Anspruch">
        <div class="statement__panel">
          <EosMark variant="icon" class="statement__o" />
          <h2 class="statement__title" data-scrub>
            {
              statement.map((w, i) => (
                <>
                  {i > 0 && ' '}
                  <span class="scrub">
                    {w === 'positiv' ? (
                      <>p<span class="dawn-o" aria-hidden="true"><span>o</span><EosMark variant="icon" /></span><span class="sr-only">o</span>sitiv</>
                    ) : (
                      w
                    )}
                  </span>
                </>
              ))
            }
          </h2>
          <p class="statement__text" data-reveal>{introText}</p>
        </div>
      </section>

      <!-- Unser Leitbild: Vision und Leitbild -->
      <section class="leitbild" id="unser-leitbild" aria-label="Unser Leitbild">
        <div class="split">
          <div class="split__media" data-reveal>
            <div class="arch arch--split">
              <Image src={vision} alt="Kinder sitzen im Kreis und unterhalten sich fröhlich" widths={[480, 800]} sizes="(min-width: 992px) 40vw, 100vw" />
            </div>
          </div>
          <div class="split__text">
            <p class="chip" data-reveal><span class="dawn-dot" aria-hidden="true"></span>Unsere Vision</p>
            <h2 class="h2" data-reveal>Wofür wir arbeiten</h2>
            <div class="prose" data-reveal set:html={panels.vision[0].html} />
          </div>
        </div>

        <div class="split split--reverse">
          <div class="split__media" data-reveal>
            <div class="arch arch--split">
              <Image src={leitbild} alt="Jugendliche legen ihre Hände übereinander als Zeichen des Zusammenhalts" widths={[480, 800]} sizes="(min-width: 992px) 40vw, 100vw" />
            </div>
          </div>
          <div class="split__text">
            <p class="chip" data-reveal><span class="dawn-dot" aria-hidden="true"></span>Unser Leitbild</p>
            <h2 class="h2" data-reveal>Wie wir arbeiten</h2>
            <p class="lead" data-reveal>
              Wir arbeiten systemisch, ressourcenorientiert und lebensweltorientiert – mit verlässlichen Beziehungen, klarer
              Struktur und echter Beteiligung der jungen Menschen und ihrer Familien.
            </p>
            <details class="more" data-more data-title="Wie wir arbeiten" data-reveal>
              <summary>Mehr erfahren</summary>
              <div class="more__detail" set:html={panels.leitbild[0].html} />
            </details>
          </div>
        </div>
      </section>

      <!-- Für wen wir da sind: zwei Karten, Details im Seitenpanel -->
      <section class="zielgruppen" aria-label="Für wen wir da sind">
        {
          zielgruppen.map((z, i) => (
            <article class:list={['zg', i === 1 && 'zg--ink']} data-reveal>
              <p class="chip">
                <span class="dawn-dot" aria-hidden="true" />
                {z.chip}
              </p>
              <h2 class="zg__text">{z.text}</h2>
              <details class="more" data-more data-title={z.chip}>
                <summary>Mehr erfahren</summary>
                <div class="more__detail" set:html={z.panel.html} />
              </details>
            </article>
          ))
        }
      </section>

      <!-- Leistungen: kompakte Karten, Details im Seitenpanel -->
      <section class="leistungen" id="leistungen" aria-labelledby="leistungen-title">
        <div class="section-head">
          <div>
            <p class="chip" data-reveal><span class="dawn-dot" aria-hidden="true"></span>Unsere Leistungen im Detail</p>
            <h2 class="h2" id="leistungen-title" data-reveal>Unsere Leistungen</h2>
          </div>
          <div class="lead" data-reveal>
            <p>
              Gemeinsam mit jungen Menschen, ihren Familien und dem Jugendamt entwickeln wir passgenaue Hilfeangebote.
              Unser systemischer Ansatz berücksichtigt die komplexen Zusammenhänge der Lebensrealitäten vor Ort.
            </p>
            <p>
              Wir garantieren eine zeitnahe Umsetzung, hohe Erreichbarkeit und transparente Kommunikation – sowohl für
              Klient*innen als auch für unsere Kooperationspartner. Unsere Arbeit ist nah am Menschen, fachlich fundiert
              und im Alltag sofort anwendbar.
            </p>
          </div>
        </div>

        <div class="cards">
          {
            leistungen.map((l) => (
              <article class="card" data-reveal>
                {l.label && <p class="card__label">{l.label}</p>}
                <h3 class="card__title">{l.name}</h3>
                <p class="card__teaser">{l.teaser}</p>
                <details class="more card__more" data-more data-title={l.title}>
                  <summary>Mehr erfahren</summary>
                  <div class="more__detail">
                    <Fragment set:html={l.body} />
                    {l.link && (
                      <p>
                        <a class="link-arrow" href={l.link} target="_blank" rel="noopener">
                          {l.title} im Gesetz
                          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </a>
                      </p>
                    )}
                  </div>
                </details>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Methoden: senkrechte Tabs -->
      <section class="methoden" aria-labelledby="methoden-title">
        <div class="section-head">
          <div>
            <p class="chip" data-reveal><span class="dawn-dot" aria-hidden="true"></span>Unsere Methoden</p>
            <h2 class="h2" id="methoden-title" data-reveal>Womit wir arbeiten</h2>
          </div>
          <div class="lead" data-reveal>
            <p>
              Wir arbeiten mit fachlich anerkannten, systemischen und alltagsnahen Methoden, die junge Menschen und Familien
              stärken, Orientierung geben und Entwicklung ermöglichen.
            </p>
            <p>Alle Methoden setzen wir so ein, dass sie verständlich, praktikabel und im Alltag umsetzbar sind.</p>
          </div>
        </div>

        <div class="tabs" data-tabs>
          <div class="tabs__side">
            <div class="tabs__list" role="tablist" aria-label="Methoden" aria-orientation="vertical">
              <span class="tabs__pill" aria-hidden="true"></span>
              {
                methoden.map((m, i) => (
                  <button
                    class="tabs__tab"
                    type="button"
                    role="tab"
                    id={`${m.id}-tab`}
                    aria-controls={m.id}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                  >
                    <span class="tabs__ray" aria-hidden="true" />
                    <span>{m.name}</span>
                  </button>
                ))
              }
            </div>
            <div class="arch arch--tabs" data-reveal>
              <Image src={methodenImg} alt="Kinder arbeiten gemeinsam am Tisch an einer kreativen Aufgabe" widths={[400, 700]} sizes="(min-width: 992px) 30vw, 100vw" />
            </div>
          </div>

          <div class="tabs__panels">
            {
              methoden.map((m, i) => (
                <div class="panel" role="tabpanel" id={m.id} aria-labelledby={`${m.id}-tab`} hidden={i !== 0} tabindex="0">
                  <p class="panel__num">{m.num}</p>
                  <h3 class="h3">{m.name}</h3>
                  <p class="panel__intro">{m.lead}</p>
                  <ul class="panel__list">
                    {m.items.map((it) => (
                      <li>
                        {it.term && <strong set:html={it.term} />}
                        <span set:html={it.desc} />
                      </li>
                    ))}
                  </ul>
                  {m.more && <p class="panel__more">… und vieles mehr.</p>}
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Unser Team -->
      <section class="team" id="unser-team" aria-labelledby="team-title">
        <h2 class="h2" id="team-title" data-reveal>Unser Team</h2>
        {
          groups.map((g) => (
            <div class="team__group">
              <h3 class="chip" data-reveal>
                <span class="dawn-dot" aria-hidden="true" />
                {g.label}
              </h3>
              <ul class="people" data-reveal-group>
                {g.members.map((p) => (
                  <li class="person">
                    <span class="person__initials" aria-hidden="true">
                      {initials(p.name)}
                    </span>
                    <h4>{p.name}</h4>
                    <p class="person__role">
                      <strong>{p.role}</strong>
                      {p.quals.map((l) => (
                        <span>{l}</span>
                      ))}
                    </p>
                    <p class="person__contact">
                      {p.phone && (
                        <a class="person__btn" href={site.phoneHref} aria-label={`${p.name} anrufen: ${p.phone}`}>
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5h2.6l1.4 4.2-2 1.4a12 12 0 0 0 6.3 6.3l1.4-2 4.2 1.4v2.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                        </a>
                      )}
                      {p.email && (
                        <a class="person__btn" href={`mailto:${p.email}`} aria-label={`E-Mail an ${p.name}`}>
                          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                        </a>
                      )}
                    </p>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <!-- Unsere Standorte: Karte erst nach Klick -->
      <section class="standorte" id="standorte" aria-labelledby="standorte-title">
        <h2 class="h2" id="standorte-title" data-reveal>Unsere Standorte</h2>
        <div class="places">
          {
            locations.map((loc) => (
              <article class="place" data-reveal>
                <div class="map" data-map={loc.mapEmbed} data-title={`Karte: ${loc.name}`}>
                  <div class="map__consent">
                    <EosMark variant="icon" class="map__o" />
                    <p>
                      Beim Laden der Karte werden Daten an Google übertragen. Mehr dazu in der{' '}
                      <a href="/datenschutzerklaerung">Datenschutzerklärung</a>.
                    </p>
                    <p class="map__actions">
                      <button class="btn btn--primary btn--sm" type="button" data-map-load>
                        Karte laden
                      </button>
                      <a href={loc.mapLink} target="_blank" rel="noopener">
                        In Google Maps öffnen
                      </a>
                    </p>
                  </div>
                </div>
                <div class="place__text">
                  <h3 class="h3">{loc.name}</h3>
                  <p>
                    {loc.street}
                    <br />
                    {loc.zip}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <!-- Footer mit den Angaben der Live-Seite -->
    <footer class="foot">
      <div class="foot__inner">
        <div class="foot__brand">
          <EosMark class="mark-intro mark-intro--view" />
        </div>
        <div class="foot__address">
          {
            locations.map((loc) => (
              <p>
                <strong>eos GmbH | {loc.city}</strong>
                <br />
                {loc.street}
                <br />
                {loc.zip}
              </p>
            ))
          }
        </div>
        <div class="foot__address">
          <p>
            Tel.: <a href={site.phoneHref}>{site.phone}</a><br />
            Fax: {site.fax}<br />
            Email: <a href={`mailto:${site.email}`}>eos(at)eos-hilfen.net</a>
          </p>
          <p>Geschäftsführung: {site.managingDirector}<br />{site.register}</p>
          <p><a class="btn btn--primary btn--sm" href={applyLink.href} data-magnet>Jetzt bewerben</a></p>
        </div>
      </div>
      <div class="foot__meta">
        <p><a href="/impressum">Impressum</a> | <a href="/datenschutzerklaerung">Datenschutz</a></p>
        <p>© {year} EOS GmbH - Kinder- und Jugendhilfe. <span style="white-space:nowrap">All rights reserved</span></p>
      </div>
    </footer>

    <dialog class="drawer" aria-labelledby="drawer-title" data-drawer>
      <div class="drawer__head">
        <h3 class="h3" id="drawer-title" data-drawer-title></h3>
        <button class="drawer__close" type="button" data-drawer-close aria-label="Schließen">×</button>
      </div>
      <div class="drawer__body" data-drawer-body></div>
    </dialog>
  </div>
</DraftLayout>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;

  /* ---------- Einblenden beim Scrollen ---------- */
  const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-group], .mark-intro--view');
  if (reduce || !('IntersectionObserver' in window)) {
    revealEls.forEach((el) => el.classList.add('is-visible'));
  } else {
    document.querySelectorAll('section').forEach((s) =>
      s.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el, i) => el.style.setProperty('--rd', `${(i % 4) * 60}ms`)),
    );
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    revealEls.forEach((el) => io.observe(el));
  }

  /* ---------- Statement: Wörter färben sich mit dem Scrollen ein ---------- */
  const scrub = document.querySelector<HTMLElement>('[data-scrub]');
  if (scrub && !reduce) {
    const words = [...scrub.querySelectorAll<HTMLElement>('.scrub')];
    scrub.classList.add('is-scrubbing');
    const update = () => {
      const r = scrub.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.9 - r.top) / (innerHeight * 0.55)));
      const lit = p * words.length;
      words.forEach((w, i) => w.style.setProperty('--lit', String(Math.min(1, Math.max(0, lit - i)))));
      // Sobald der Satz eingefärbt ist, geht im „o“ das Licht auf
      scrub.classList.toggle('is-done', p >= 1);
    };
    addEventListener('scroll', update, { passive: true });
    update();
  } else scrub?.classList.add('is-done');

  /* ---------- „Mehr erfahren“ öffnet ein Seitenpanel ----------
     Ohne JS klappen die Details einfach auf. */
  const drawer = document.querySelector<HTMLDialogElement>('[data-drawer]');
  if (drawer && 'showModal' in drawer) {
    const body = drawer.querySelector<HTMLElement>('[data-drawer-body]')!;
    let opener: HTMLElement | null = null;
    const close = () => {
      drawer.classList.add('is-closing');
      setTimeout(() => {
        drawer.classList.remove('is-closing');
        drawer.close();
        opener?.focus();
      }, 200);
    };
    document.querySelectorAll<HTMLDetailsElement>('[data-more]').forEach((d) => {
      const summary = d.querySelector('summary')!;
      summary.addEventListener('click', (e) => {
        e.preventDefault();
        drawer.querySelector('[data-drawer-title]')!.textContent = d.dataset.title ?? '';
        body.replaceChildren(...[...d.querySelector('.more__detail')!.children].map((n) => n.cloneNode(true)));
        opener = summary as HTMLElement;
        drawer.showModal();
        body.scrollTop = 0;
      });
    });
    drawer.querySelector('[data-drawer-close]')!.addEventListener('click', close);
    drawer.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) close();
    });
  }

  /* ---------- Methoden: Tabs mit gleitender Pille ---------- */
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[role="tablist"]')!;
    const pill = list.querySelector<HTMLElement>('.tabs__pill')!;
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const movePill = (tab: HTMLElement) => {
      pill.style.width = `${tab.offsetWidth}px`;
      pill.style.height = `${tab.offsetHeight}px`;
      pill.style.transform = `translateY(${tab.offsetTop}px)`;
    };
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!)!;
        panel.hidden = !on;
        panel.classList.toggle('is-in', on);
      });
      movePill(tab);
      if (focus) tab.focus();
    };
    list.classList.add('has-pill');
    movePill(tabs[0]);
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (e.key === 'Home') select(tabs[0], true);
        else if (e.key === 'End') select(tabs.at(-1)!, true);
        else if (step) select(tabs[(i + step + tabs.length) % tabs.length], true);
        else return;
        e.preventDefault();
      });
    });
    addEventListener('resize', () => movePill(tabs.find((t) => t.getAttribute('aria-selected') === 'true')!));
  });

  /* ---------- Magnetische Knöpfe (wie IEV, mit Feder) ---------- */
  if (finePointer && !reduce) {
    document.querySelectorAll<HTMLElement>('[data-magnet]').forEach((el) => {
      let tx = 0, ty = 0, x = 0, y = 0, vx = 0, vy = 0, raf = 0;
      const MAX = 6;
      const tick = () => {
        vx = (vx + (tx - x) * 0.12) * 0.72;
        vy = (vy + (ty - y) * 0.12) * 0.72;
        x += vx;
        y += vy;
        el.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0)`;
        raf = Math.abs(tx - x) + Math.abs(ty - y) + Math.abs(vx) + Math.abs(vy) > 0.05 ? requestAnimationFrame(tick) : 0;
      };
      const run = () => {
        if (!raf) raf = requestAnimationFrame(tick);
      };
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        tx = Math.max(-MAX, Math.min(MAX, (e.clientX - r.left - r.width / 2) * 0.18));
        ty = Math.max(-MAX, Math.min(MAX, (e.clientY - r.top - r.height / 2) * 0.3));
        run();
      });
      el.addEventListener('pointerleave', () => {
        tx = 0;
        ty = 0;
        run();
      });
    });
  }

  /* ---------- Karten erst nach Klick ---------- */
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) =>
    map.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = map.dataset.map!;
      iframe.title = map.dataset.title!;
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      map.replaceChildren(iframe);
    }),
  );

  /* ---------- Navigation: aktiver Abschnitt, Menü auf dem Telefon ---------- */
  const navEl = document.querySelector<HTMLElement>('.nav')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const secs = links.map((a) => document.querySelector<HTMLElement>(a.hash)!).filter(Boolean);
  const spy = () => {
    navEl.classList.toggle('is-stuck', scrollY > 8);
    let cur = secs[0]?.id ?? '';
    for (const s of secs) if (s.getBoundingClientRect().top < innerHeight * 0.4) cur = s.id;
    links.forEach((a) => a.classList.toggle('is-active', a.hash === `#${cur}`));
  };
  addEventListener('scroll', spy, { passive: true });
  spy();
  const menu = document.querySelector<HTMLButtonElement>('[data-menu]')!;
  menu.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') !== 'true';
    menu.setAttribute('aria-expanded', String(open));
    navEl.classList.toggle('is-open', open);
  });
  navEl.querySelectorAll('.nav__links a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.setAttribute('aria-expanded', 'false');
      navEl.classList.remove('is-open');
    }),
  );
</script>

