---
import SiteLayout from '../layouts/SiteLayout.astro';
import EosMark from '../components/EosMark.astro';
---

<SiteLayout title="Seite nicht gefunden" noindex>
  <section class="page-head page-head--center">
    <EosMark variant="icon" class="page-head__o" />
    <h1 class="h2 hero-in" style="--d:0">Diese Seite gibt es leider nicht.</h1>
    <p class="lead hero-in" style="--d:1">Vielleicht hilft Ihnen die Startseite weiter.</p>
    <p class="hero-in" style="--d:2"><a class="btn btn--primary" href="/" data-magnet>Zur Startseite</a></p>
  </section>
</SiteLayout>
