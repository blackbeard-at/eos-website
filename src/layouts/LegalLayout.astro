---
// Rechtstexte (Impressum, Datenschutz) im Design der Website.
// <!--EMAIL--> im Text wird zur geschützten Adresse (kein Klartext im HTML).
import SiteLayout from './SiteLayout.astro';
import Mail from '../components/Mail.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  html: string;
}

const { title, html } = Astro.props;
// Überschrift steht schon im Seitenkopf: gleichlautende erste Überschrift weglassen
const body = html.replace(new RegExp(`^\\s*<h3>${title}</h3>\\s*`), '');
const parts = body.split('<!--EMAIL-->');
---

<SiteLayout title={title}>
  <section class="page-head page-head--legal">
    <p class="chip hero-in" style="--d:0"><span class="dawn-dot" aria-hidden="true"></span>Rechtliches</p>
    <h1 class="h2 hero-in" style="--d:1">{title}</h1>
  </section>
  <article class="legal">
    {
      parts.map((part, i) => (
        <>
          {i > 0 && <Mail email={site.email} />}
          <Fragment set:html={part} />
        </>
      ))
    }
  </article>
</SiteLayout>
