---
// Karten: Google Maps wird erst nach Klick geladen (Zwei-Klick-Lösung,
// da die statische Seite keinen Cookie-Banner mehr hat).
import { locations } from '../data/site';
---

<section class="standorte" id="standorte">
  <div class="container">
    <h2 class="badge">Unsere Standorte</h2>

    <div class="standorte__grid">
      {
        locations.map((loc) => (
          <div class="standorte__item">
            <div class="standorte__map" data-map={loc.mapEmbed} data-title={`Karte: ${loc.name}`}>
              <div class="standorte__consent">
                <p>
                  Mit Klick auf „Karte laden“ wird Google Maps geladen. Dabei werden Daten an Google übertragen (siehe{' '}
                  <a href="/datenschutzerklaerung">Datenschutz</a>).
                </p>
                <div class="standorte__actions">
                  <button class="btn" type="button" data-map-load>
                    Karte laden
                  </button>
                  <a class="standorte__ext link-underline" href={loc.mapLink} target="_blank" rel="noopener">
                    <span>In Google Maps öffnen</span>
                  </a>
                </div>
              </div>
            </div>
            <div class="standorte__card">
              <h3 class="h5">{loc.name}</h3>
              <p>
                {loc.street}
                <br />
                {loc.zip}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((box) => {
    box.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = box.dataset.map!;
      iframe.title = box.dataset.title!;
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
    });
  });
</script>

<style>
  .standorte {
    padding: 72px 0 var(--s3);
    background: var(--bg);
  }

  .standorte__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px;
    margin-top: 36px;
  }

  .standorte__map {
    height: 300px;
    background: var(--dark);
  }

  .standorte__map :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .standorte__consent {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    padding: 36px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 13px;
    line-height: 1.6;
    text-align: center;
  }

  .standorte__consent a { color: var(--white); text-decoration: underline; }

  .standorte__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 18px 27px;
    margin-top: 18px;
  }

  .standorte__actions .btn { color: var(--white); border-color: var(--white); }
  .standorte__actions .btn:hover { background: var(--white); color: var(--dark); }

  .standorte__consent .standorte__ext {
    color: var(--white);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .standorte__card {
    padding: 36px;
    background: var(--white);
    text-align: center;
  }

  .standorte__card p { margin-top: 18px; }

  @media (max-width: 959px) {
    .standorte__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
