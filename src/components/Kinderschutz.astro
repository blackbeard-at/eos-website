---
// Kinderschutz und Qualität (Textübergabe 7, neu): vier Schritte als
// nummerierte Karten, darunter „Was uns verbindlich macht“. Kein Download.
import { kinderschutz } from '../data/texte';
---

<section class="kinderschutz" id="kinderschutz">
  <div class="container">
    <div class="kinderschutz__head" data-anim="alpha">
      <h2 class="badge">Kinderschutz</h2>
      <h3 class="h3 kinderschutz__title">{kinderschutz.title}</h3>
      <p>{kinderschutz.intro}</p>
    </div>

    <ol class="kinderschutz__steps">
      {
        kinderschutz.steps.map((step, i) => (
          <li class="kinderschutz__step" data-anim="alpha" style={`--delay: ${i * 0.1}s`}>
            <span class="kinderschutz__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h4 class="h5">{step.title}</h4>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="kinderschutz__list" data-anim="alpha">
      <h4 class="h5">{kinderschutz.listTitle}</h4>
      <ul>
        {kinderschutz.list.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .kinderschutz {
    padding: var(--s3) 0;
    background: var(--bg);
  }

  .kinderschutz__head { max-width: 900px; }

  .kinderschutz__title { margin-top: 18px; }

  .kinderschutz__head p { margin-top: 18px; }

  .kinderschutz__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 36px;
    margin: 54px 0 0;
    padding: 0;
    list-style: none;
  }

  .kinderschutz__step {
    padding: 36px 27px;
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .kinderschutz__num {
    display: block;
    color: var(--accent);
    font-size: 32px;
    font-weight: 800;
    line-height: 1;
  }

  .kinderschutz__step h4 { margin-top: 18px; }

  .kinderschutz__step p { margin-top: 9px; }

  .kinderschutz__list { margin-top: 54px; }

  .kinderschutz__list ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 72px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .kinderschutz__list li {
    position: relative;
    padding: 12px 0 12px 22px;
    border-top: 1px solid var(--line);
  }

  .kinderschutz__list li::before {
    content: '';
    position: absolute;
    top: calc(12px + 0.8em);
    left: 2px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (max-width: 1299px) {
    .kinderschutz__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 959px) {
    .kinderschutz__list ul { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 569px) {
    .kinderschutz__steps { grid-template-columns: minmax(0, 1fr); gap: 18px; }
  }
</style>
