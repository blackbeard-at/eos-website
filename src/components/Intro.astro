---
import Accordion from './Accordion.astro';
import { panels } from '../data/site';
---

<section class="intro">
  <div class="container">
    <h2 class="h3">Wir sind ein freier Träger der ambulanten Kinder- und Jugendhilfe.</h2>
    <p class="intro__lead h5 fw-400">
      Unser Ziel: junge Menschen stärken, Familien stabilisieren und Hilfen wirksam gestalten – verlässlich,
      respektvoll und fachlich fundiert.
    </p>
    <Accordion items={panels.intro} class="intro__acc" />
  </div>
</section>

<style>
  .intro {
    padding: 72px 0;
    background: var(--bg);
  }

  .intro__lead {
    margin-top: 36px;
    color: var(--heading);
    line-height: 1.2;
  }

  .intro :global(.intro__acc) { margin-top: 35px; }

  .intro :global(.acc__text) {
    color: var(--text);
    font-size: 17px;
    line-height: 1.75;
  }
</style>
