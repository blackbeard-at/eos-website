---
// Bild + Text nebeneinander (Vision / Leitbild). Bild gleitet von der Seite
// herein, Text blendet verzögert ein; beide mit leichter Parallaxe.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Accordion from './Accordion.astro';
import type { Panel } from '../data/site';

interface Props {
  id?: string;
  badge: string;
  title: string;
  text: string;
  image: ImageMetadata;
  alt: string;
  imageSide?: 'left' | 'right';
  items: Panel[];
  class?: string;
}

const { id, badge, title, text, image, alt, imageSide = 'left', items, class: className } = Astro.props;
---

<section class:list={['split-section', `split-section--${imageSide}`, className]} id={id}>
  <div class="container cols">
    <div class="split-section__media" data-anim={imageSide === 'left' ? 'ltr' : 'rtl'}>
      <div data-parallax="2">
        <div class="media-round media-shadow split-section__img">
          <Image src={image} alt={alt} widths={[500, 800, 1000]} sizes="(max-width: 959px) 100vw, 40vw" />
        </div>
      </div>
    </div>

    <div class="split-section__text" data-anim="alpha" style="--delay: 0.2s">
      <div data-parallax="1">
        <h2 class="badge">{badge}</h2>
        <h3 class="h3 split-section__title">{title}</h3>
        <p class="split-section__lead">{text}</p>
        <Accordion items={items} />
      </div>
    </div>
  </div>
</section>

<style>
  .split-section { background: var(--white); }

  .split-section .cols { align-items: start; }

  .split-section--right .split-section__media { order: 2; }

  .split-section__img { aspect-ratio: 4 / 3; }

  .split-section__title { margin-top: 18px; }

  .split-section__lead { margin-top: 18px; }

  @media (max-width: 959px) {
    .split-section--right .split-section__media { order: 0; }
  }
</style>
