---
// Punkt-Navigation rechts am Rand (Uncode „onepage pagination“):
// aktiver Abschnitt = größerer weißer Punkt, beim Hover rotes Label.
import { navigation } from '../data/site';
---

<ul class="dots" aria-label="Abschnitte">
  {
    navigation.map((item) => (
      <li>
        <a href={item.href} data-section={item.href.split('#')[1]}>
          <span class="dots__dot" />
          <span class="dots__label">{item.label}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .dots {
    position: fixed;
    z-index: 100;
    top: 50%;
    right: 22px;
    width: 30px;
    margin: 0;
    padding: 0;
    list-style: none;
    transform: translateY(-50%);
  }

  .dots li {
    position: relative;
    height: 1.8em;
    text-align: right;
  }

  .dots a {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
  }

  .dots__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.2);
    transition: all 100ms ease-in-out;
  }

  .dots a:hover .dots__dot,
  .dots a.is-current .dots__dot {
    background: var(--white);
    transform: scale(1.3);
  }

  .dots a.is-current { pointer-events: none; }

  .dots__label {
    position: absolute;
    top: -2px;
    left: -12px;
    padding: 6px 18px;
    border-radius: 2px;
    background: var(--accent);
    color: var(--white);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.75;
    white-space: pre;
    opacity: 0;
    pointer-events: none;
    transform-origin: 0% 50%;
    transform: scale(0.5) translateX(-100%);
    transition: opacity 0.1s ease-out, transform 0.1s ease-out;
  }

  .dots__label::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -5px;
    margin-top: -5px;
    border-style: solid;
    border-width: 5px 0 5px 5px;
    border-color: transparent transparent transparent var(--accent);
  }

  .dots a:hover .dots__label {
    opacity: 1;
    transform: scale(1) translateX(-100%);
    transition-delay: 0.1s;
  }

  @media (hover: none), (max-width: 959px) {
    .dots { display: none; }
  }
</style>
