---
import { Image } from 'astro:assets';
import Accordion from './Accordion.astro';
import image from '../assets/images/methoden.jpg';
import { methoden } from '../data/texte';
import { para } from '../lib/html';

// Sechs Gruppen; Inhalt wörtlich als Aufzählung im Fließtext
const items = methoden.groups.map((g, i) => ({ title: `${i + 1}. ${g.name}`, html: para(g.items.join(', ')) }));
---

<section class="methoden">
  <div class="methoden__inner cols">
    <div class="methoden__img">
      <Image
        src={image}
        alt="Kinder arbeiten gemeinsam am Tisch an einer kreativen Aufgabe"
        widths={[600, 900, 1300]}
        sizes="(max-width: 959px) 100vw, 45vw"
      />
    </div>

    <div>
      <h2 class="badge">Unsere Methoden</h2>
      <h3 class="h3 methoden__title">Womit wir arbeiten</h3>
      <p>{methoden.intro}</p>
      <Accordion items={items} />
    </div>
  </div>
</section>

<style>
  .methoden { background: var(--white); }

  .methoden__inner {
    max-width: 1500px;
    margin-inline: auto;
    padding: var(--s4) var(--s1);
    align-items: start;
  }

  .methoden__img {
    overflow: hidden;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-xl);
  }

  .methoden__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .methoden__title { margin-top: 18px; }

  .methoden p { margin-top: 18px; }
</style>
